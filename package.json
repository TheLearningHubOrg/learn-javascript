{
  "name": "learn-javascript",
  "version": "1.20.0",
  "private": true,
  "description": "Learn JavaScript from syntax to staff-level runtime internals, with a dependency-free Node.js starter API.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "demo": "node src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write src tests eslint.config.js",
    "format:check": "prettier --check src tests eslint.config.js"
  },
  "keywords": [
    "javascript",
    "ecmascript",
    "v8",
    "event-loop",
    "closures",
    "prototypes",
    "async"
  ],
  "author": "Manthan Ankolekar",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLearningHubOrg/learn-javascript.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
